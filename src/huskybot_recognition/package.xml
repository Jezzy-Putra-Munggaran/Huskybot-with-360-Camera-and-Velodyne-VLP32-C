<?xml version="1.0"?> <!-- [WAJIB] Header XML standar, wajib untuk semua file XML ROS2 -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?> <!-- [WAJIB] Validasi schema agar sesuai standar ROS2 -->
<package format="3"> <!-- [WAJIB] Format package.xml ROS2 (format 3, wajib untuk ROS2 Humble) -->
  <name>huskybot_recognition</name> <!-- [WAJIB] Nama package, harus sama dengan folder dan CMakeLists.txt -->
  <version>0.1.0</version> <!-- [WAJIB] Versi package, update jika ada perubahan besar (best practice release) -->
  <description>
    ROS2 package for multi-camera YOLOv12 detection, panorama stitching, and logging for Huskybot simulation and real robot.
    Includes nodes for YOLOv12 detection, panorama inference, detection logging, and result listeners.
    Fully compatible with ROS2 Humble, Gazebo, and multi-robot simulation.
    (Update 2025-05-06)
  </description> <!-- [WAJIB] Deskripsi package, WAJIB diisi dan selalu update -->
  <maintainer email="mungguran.jezzy.putra@gmail.com">Jezzy Putra Munggaran</maintainer> <!-- [WAJIB] Nama & email maintainer, WAJIB diisi -->
  <author email="mungguran.jezzy.putra@gmail.com">Jezzy Putra Munggaran</author> <!-- [SARAN] Author package, untuk metadata tambahan -->
  <license>Apache-2.0</license> <!-- [WAJIB] Lisensi package, WAJIB diisi (misal: Apache-2.0, BSD-3-Clause, MIT) -->

  <buildtool_depend>ament_cmake</buildtool_depend> <!-- [WAJIB] Dependency utama build tool ROS2 (WAJIB untuk package CMake) -->

  <exec_depend>rclpy</exec_depend> <!-- [WAJIB] Dependency runtime Python client library ROS2 -->
  <exec_depend>sensor_msgs</exec_depend> <!-- [WAJIB] Dependency runtime message sensor_msgs (untuk Image) -->
  <exec_depend>cv_bridge</exec_depend> <!-- [WAJIB] Dependency runtime bridge ROS <-> OpenCV -->
  <exec_depend>yolov12_msgs</exec_depend> <!-- [WAJIB] Dependency runtime custom message YOLOv12 (harus sudah di-build) -->
  <exec_depend>python3-opencv</exec_depend> <!-- [WAJIB] Dependency runtime OpenCV Python (untuk image processing) -->
  <exec_depend>python3-numpy</exec_depend> <!-- [WAJIB] Dependency runtime numpy Python (untuk array/matrix) -->
  <exec_depend>python3-yaml</exec_depend> <!-- [WAJIB] Dependency runtime PyYAML (untuk baca file kalibrasi) -->
  <exec_depend>ultralytics</exec_depend> <!-- [WAJIB] Dependency runtime YOLOv12 Python (pastikan sudah pip install ultralytics) -->
  <exec_depend>onnxruntime-gpu</exec_depend> <!-- [SARAN] Tambahkan dependency runtime ONNX Runtime GPU (untuk fallback .onnx di Jetson Orin) -->
  <exec_depend>python3-logging</exec_depend> <!-- [SARAN] Tambahkan dependency logging Python (untuk error handling file log) -->
  <exec_depend>python3-pip</exec_depend> <!-- [SARAN] Tambahkan pip agar dependency Python bisa diinstall runtime jika perlu -->

  <test_depend>ament_lint_auto</test_depend> <!-- [BEST PRACTICE] Dependency untuk linting/testing otomatis -->
  <test_depend>ament_lint_common</test_depend> <!-- [BEST PRACTICE] Dependency untuk linting/testing umum -->
  <test_depend>pytest</test_depend> <!-- [BEST PRACTICE] Dependency untuk unit test Python (opsional, best practice) -->

  <export>
    <build_type>ament_cmake</build_type> <!-- [WAJIB] Tipe build system (ament_cmake untuk CMake) -->
    <architecture_independent/> <!-- [WAJIB] Package ini tidak tergantung arsitektur (pure Python/launch) -->
    <description lang="en">YOLOv12 multi-camera recognition and logging for Huskybot in ROS2 Humble.</description> <!-- [SARAN] Deskripsi tambahan multi-bahasa -->
    <readme>README.md</readme> <!-- [BEST PRACTICE] Path ke file README untuk dokumentasi package -->
    <url type="website">https://github.com/jezzy/huskybot</url> <!-- [BEST PRACTICE] URL website/repo utama package -->
    <url type="bugtracker">https://github.com/jezzy/huskybot/issues</url> <!-- [BEST PRACTICE] URL bugtracker/issues -->
  </export>
</package>