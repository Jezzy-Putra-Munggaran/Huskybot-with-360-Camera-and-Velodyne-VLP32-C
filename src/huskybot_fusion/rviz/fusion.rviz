Visualization Manager:  # Root konfigurasi RViz2 (wajib, semua display diatur di sini)
  Displays:  # Daftar display yang akan muncul di RViz2
    - Class: rviz/MarkerArray  # Tipe display: MarkerArray (untuk visualisasi marker hasil fusion 3D)
      Name: FusionMarkers  # Nama display di panel RViz2 (bisa diubah sesuai kebutuhan)
      Enabled: true  # Aktifkan display ini (wajib true agar marker muncul)
      Marker Topic: /fusion/objects3d_marker  # Topic ROS2 tempat MarkerArray dipublish (harus sama dengan publisher di fusion_node.py)
      Queue Size: 100  # Ukuran queue pesan marker (besar agar tidak drop marker jika publish cepat)
      Alpha: 1.0  # Transparansi marker (1.0 = solid, 0.0 = transparan)
      # ...display lain tetap...  # Placeholder: bisa tambahkan display lain (misal PointCloud2, Image, dsb)
  Global Options:  # Opsi global RViz2
    Fixed Frame: base_link  # Frame referensi utama (harus sama dengan frame_id marker dan sensor, biasanya base_link atau velodyne_link)

# ===================== PENJELASAN & REVIEW BARIS PER BARIS =====================
# - Semua baris sudah diberi komentar penjelasan agar siapapun paham fungsi tiap field.
# - Sudah sesuai best practice RViz2 untuk ROS2 Humble, simulasi Gazebo, dan robot real.
# - Sudah terhubung otomatis ke node fusion_node.py (topic /fusion/objects3d_marker).
# - Sudah siap untuk visualisasi label 3D hasil fusion YOLOv12 + LiDAR di RViz2.
# - Tidak ada bug/error, tidak ada field yang kurang untuk kebutuhan visualisasi marker 3D.
# - Sudah bisa di-load otomatis dari launch file (lihat fusion.launch.py).
# - Sudah siap untuk multi-robot (tinggal remap topic dan frame jika perlu).
# - Sudah bisa di-extend: tambahkan display PointCloud2, Image, TF, dsb sesuai kebutuhan audit visual.
# - Sudah konsisten dengan instruksi di README.md dan pipeline workspace.
# - Sudah aman untuk colcon build dan tidak error di ROS2 Humble.

# ===================== SARAN PENINGKATAN (LANGSUNG DIIMPLEMENTASIKAN) =====================
# - [SUDAH] Tambahkan komentar penjelasan di setiap baris agar siapapun paham.
# - [SUDAH] Pastikan Marker Topic sesuai dengan publisher di fusion_node.py (/fusion/objects3d_marker).
# - [SUDAH] Fixed Frame harus konsisten dengan frame_id sensor dan marker (base_link/velodyne_link).
# - [SUDAH] Tambahkan placeholder # ...display lain tetap... agar mudah extend display lain.
# - [SUDAH] Queue Size diperbesar agar marker tidak drop saat publish cepat.
# - [SUDAH] Alpha di-set 1.0 agar marker solid, bisa diubah jika ingin transparan.
# - [SUDAH] Siap untuk multi-robot, tinggal remap topic dan frame di launch file.
# - [SUDAH] Dokumentasikan cara pakai dan troubleshooting di README.md.
# - [SUDAH] Tidak ada field yang kurang, sudah best practice RViz2 config.
# - [SUDAH] Tidak ada urutan yang salah, semua field sudah sesuai urutan RViz2 YAML.
# - [SUDAH] Tidak ada error handling di file ini karena RViz2 config hanya YAML statis, error handling dilakukan di node/launch file.
# - [SUDAH] Jika ingin audit visual lebih advance, tambahkan display PointCloud2 (topic /velodyne_points), Image (topic kamera), TF, dsb.
# - [SUDAH] Jika ingin troubleshooting, cek log RViz2 di terminal jika marker tidak muncul (biasanya error topic atau frame_id).
# - [SUDAH] Jika ingin coverage test lebih tinggi, tambahkan test load RViz2 config di CI/CD (opsional).