Panels:  # Main Panels configuration section for RViz2 UI layout
  - Class: rviz_common/Displays  # Primary panel for visualization displays
    Help Height: 78  # Height of help section in pixels
    Name: Displays  # Name of the panel in the RViz2 interface
    Property Tree Widget:  # Widget for organizing property display
      Expanded:  # List of expanded categories in the display tree
        - /Global Options1  # Global options expanded by default
        - /FusionMarkers1  # Fusion markers expanded by default
        - /PointCloud21  # PointCloud2 expanded by default
      Splitter Ratio: 0.5  # Ratio for the property tree splitter position
    Tree Height: 728  # Height of the tree widget in pixels
  - Class: rviz_common/Selection  # Panel for selection tool options
    Name: Selection  # Name of the selection panel
  - Class: rviz_common/Tool Properties  # Panel for tool properties
    Expanded:  # List of expanded tool properties
      - /2D Goal Pose1  # 2D navigation goal tool expanded
    Name: Tool Properties  # Name of the tool properties panel
    Splitter Ratio: 0.5  # Ratio for the tool property splitter position
  - Class: rviz_common/Views  # Panel for view controls
    Expanded:  # List of expanded view controls
      - /Current View1  # Current view controls expanded
    Name: Views  # Name of the views panel
    Splitter Ratio: 0.5  # Ratio for the view controls splitter position
  - Class: rviz_common/Time  # Panel for time controls (important for simulation)
    Experimental: false  # Flag for experimental features
    Name: Time  # Name of the time panel
    SyncMode: 0  # Synchronization mode (0 = wall time)
    SyncSource: ""  # Source for time synchronization (empty = independent)

Visualization Manager:  # Root configuration for RViz2 visualization (all displays configured here)
  Class: ""  # Class name (empty for root manager)
  Displays:  # List of all visual displays in RViz2
    - Class: rviz_default_plugins/MarkerArray  # Type of display: MarkerArray (for 3D object visualization)
      Name: FusionMarkers  # Display name shown in RViz2 (descriptive for users)
      Enabled: true  # Display is active when RViz2 starts (important for immediate visualization)
      Marker Topic: /fusion/objects3d_marker  # ROS2 topic this display subscribes to (published by fusion_node.py)
      Queue Size: 100  # Maximum messages to queue (increased for high-frequency publishing)
      Alpha: 1.0  # Opacity of markers (1.0 = fully opaque, 0.0 = invisible)
      Namespaces:  # Marker namespaces to show (filled at runtime)
        {}  # Initially empty, will populate with detected objects
      Value: true  # Enable/disable status
      
    - Class: rviz_default_plugins/PointCloud2  # Display for LiDAR point cloud data
      Name: VelodynePointCloud  # Display name for the point cloud visualization
      Enabled: true  # Point cloud visible at startup
      Topic: /velodyne_points  # ROS2 topic for Velodyne VLP-32C point cloud
      Queue Size: 10  # Message queue length for point cloud (reduced due to large data size)
      Alpha: 1.0  # Opacity of point cloud
      Autocompute Intensity Bounds: true  # Automatically scale intensity colors
      Decay Time: 0  # Time before points disappear (0 = no decay)
      Max Intensity: 10  # Maximum intensity value for coloring
      Min Intensity: 0  # Minimum intensity value for coloring
      Position Transformer: XYZ  # How to interpret position data
      Selectable: true  # Allow selection of points
      Size (Pixels): 2  # Size of each point in display
      Style: Points  # Visualization style (Points/Spheres/Boxes)
      Value: true  # Enable/disable status
      
    - Class: rviz_default_plugins/Image  # Display for camera image
      Name: CameraImage  # Display name for the camera feed
      Enabled: true  # Camera image visible at startup
      Topic: /panorama/image_raw  # ROS2 topic for camera feed
      Queue Size: 2  # Small queue due to large image data
      Value: true  # Enable/disable status
      
    - Class: rviz_default_plugins/TF  # Display for coordinate frames
      Name: TF  # Display name for transform frames
      Enabled: true  # TF visible at startup
      Frame Timeout: 15  # How long to display disconnected frames
      Marker Scale: 1  # Size of coordinate frame markers
      Show Arrows: true  # Show rotation axes as arrows
      Show Axes: true  # Show coordinate axes
      Show Names: true  # Show frame names
      Value: true  # Enable/disable status
      
  Global Options:  # Global settings for the entire visualization
    Background Color: 48; 48; 48  # Gray background (easier on the eyes than black)
    Fixed Frame: base_link  # Reference frame for all visualizations (base_link is the robot's body frame)
    Frame Rate: 30  # Target frame rate for rendering
    
  Tools:  # Interactive tools available in RViz2
    - Class: rviz_default_plugins/MoveCamera  # Tool for camera movement
    - Class: rviz_default_plugins/Select  # Tool for selecting elements
    - Class: rviz_default_plugins/FocusCamera  # Tool for focusing camera on objects
    - Class: rviz_default_plugins/Measure  # Tool for measuring distances
    - Class: rviz_default_plugins/PublishPoint  # Tool for publishing 3D points
    - Class: rviz_default_plugins/SetInitialPose  # Tool for setting the robot's initial pose
    - Class: rviz_default_plugins/SetGoal  # Tool for setting navigation goals
    - Class: rviz_default_plugins/PublishPointCloud2  # Tool for publishing point cloud data

  Value: true  # Enable the entire visualization
  
  Views:  # Camera view configurations
    Current:  # Current active view
      Class: rviz_default_plugins/Orbit  # Orbital camera type
      Distance: 10.0  # Distance from focal point
      Enable Stereo Rendering: false  # Disable stereo rendering
      Focal Point:  # Center point for camera orbit
        X: 0.0  # X coordinate in meters
        Y: 0.0  # Y coordinate in meters
        Z: 0.0  # Z coordinate in meters
      Focal Shape Fixed Size: true  # Keep focal shape constant size
      Focal Shape Size: 0.05  # Size of focal point indicator
      Invert Z Axis: false  # Don't invert Z axis
      Name: Current View  # Name of this view
      Near Clip Distance: 0.01  # Nearest visible distance
      Pitch: 0.5  # Camera pitch angle in radians
      Target Frame: <Fixed Frame>  # Frame to track (uses fixed frame)
      Value: Orbit (rviz)  # View type
      Yaw: 0.5  # Camera yaw angle in radians
    Saved: ~  # No saved views yet
    
Window Geometry:  # RViz2 window layout settings
  Displays:  # Position of Displays panel
    collapsed: false  # Not collapsed
  Height: 1025  # Window height in pixels
  Hide Left Dock: false  # Show left dock
  Hide Right Dock: false  # Show right dock
  QMainWindow State: 
  Selection:  # Position of Selection panel
    collapsed: false  # Not collapsed
  Time:  # Position of Time panel
    collapsed: false  # Not collapsed
  Tool Properties:  # Position of Tool Properties panel
    collapsed: false  # Not collapsed
  Views:  # Position of Views panel
    collapsed: false  # Not collapsed
  Width: 1853  # Window width in pixels
  X: 67  # Window X position
  Y: 27  # Window Y position