<?xml version="1.0"?>  <!-- [WAJIB] Header XML standar, wajib untuk semua file XML ROS2 -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?> <!-- [BEST PRACTICE] Validasi schema agar sesuai standar ROS2 -->
<package format="3">  <!-- [WAJIB] Format package.xml ROS2 (format 3, wajib untuk ROS2 Humble) -->
  <name>huskybot_description</name>  <!-- [WAJIB] Nama package, harus sama dengan folder dan CMakeLists.txt -->
  <version>0.1.0</version>  <!-- [WAJIB] Versi package, update jika ada perubahan besar (best practice release) -->
  <description>
    URDF/Xacro, mesh, dan launch file untuk simulasi Huskybot dengan kamera dan LiDAR di ROS2.
    Mendukung integrasi penuh dengan Gazebo, robot_state_publisher, dan sensor_msgs.
    (Update 2025-05-05)
  </description>  <!-- [WAJIB] Deskripsi package, WAJIB diisi dan selalu update -->
  <maintainer email="mungguran.jezzy.putra@gmail.com">Jezzy Putra Munggaran</maintainer>  <!-- [WAJIB] Nama & email maintainer -->
  <author email="mungguran.jezzy.putra@gmail.com">Jezzy Putra Munggaran</author>  <!-- [DISARANKAN] Author package, metadata tambahan -->
  <license>Apache-2.0</license>  <!-- [WAJIB] Lisensi package, wajib untuk distribusi legal -->

  <buildtool_depend>ament_cmake</buildtool_depend>  <!-- [WAJIB] Build tool utama ROS2 (wajib untuk CMake) -->
  <exec_depend>xacro</exec_depend>  <!-- [WAJIB] Runtime dependency parsing file .xacro (wajib jika pakai Xacro di launch/script) -->
  <exec_depend>urdf</exec_depend>  <!-- [WAJIB] Runtime dependency parsing file .urdf (wajib jika ada URDF) -->
  <exec_depend>sensor_msgs</exec_depend>  <!-- [WAJIB] Pesan sensor (CameraInfo, PointCloud2, dsb) -->
  <exec_depend>robot_state_publisher</exec_depend>  <!-- [WAJIB] Untuk publish TF dari URDF -->
  <exec_depend>gazebo_ros</exec_depend>  <!-- [WAJIB] Untuk integrasi plugin Gazebo (spawn_entity, plugin sensor, dsb) -->
  <exec_depend>std_msgs</exec_depend>  <!-- [WAJIB] Pesan standar ROS2 (misal: String, Header) -->
  <exec_depend>geometry_msgs</exec_depend>  <!-- [WAJIB] Pesan geometri (Twist, Pose, dsb) -->
  <exec_depend>nav_msgs</exec_depend>  <!-- [WAJIB] Pesan navigasi (Path, Odometry, dsb) -->
  <exec_depend>launch</exec_depend>  <!-- [WAJIB] Untuk launch file Python (agar ros2 launch bisa jalan) -->
  <exec_depend>launch_ros</exec_depend>  <!-- [WAJIB] Untuk launch file ROS2 (Node, dsb) -->
  <exec_depend>ament_index_python</exec_depend>  <!-- [WAJIB] Untuk get_package_share_directory di Python launch -->
  <exec_depend>rclpy</exec_depend>  <!-- [WAJIB] Untuk node Python ROS2 (wajib jika ada script Python ROS2) -->
  <exec_depend>tf2_ros</exec_depend>  <!-- [SARAN] Untuk TF2 jika ada node custom (aktifkan jika workspace butuh multi-robot robust) -->
  <exec_depend>image_transport</exec_depend>  <!-- [SARAN] Untuk pipeline kamera/image jika ada node custom image pipeline -->
  <!-- [SARAN] Tambahkan dependency lain jika ada node custom baru di masa depan (misal: message_filters, cv_bridge, dsb) -->

  <test_depend>ament_lint_auto</test_depend>  <!-- [BEST PRACTICE] Linting otomatis saat test (CI/CD) -->
  <test_depend>ament_lint_common</test_depend>  <!-- [BEST PRACTICE] Linting umum saat test (CI/CD) -->
  <test_depend>launch_testing</test_depend>  <!-- [BEST PRACTICE] Launch test ROS2 (opsional, best practice) -->
  <test_depend>pytest</test_depend>  <!-- [BEST PRACTICE] Unit test Python (opsional, best practice) -->

  <doc_depend>sphinx</doc_depend>  <!-- [OPSIONAL] Dependency dokumentasi auto (misal: sphinx, opsional jika generate doc) -->
  <doc_depend>doxygen</doc_depend>  <!-- [OPSIONAL] Dependency dokumentasi auto (misal: doxygen, opsional jika generate doc) -->

  <export>
    <build_type>ament_cmake</build_type>  <!-- [WAJIB] Tipe build system (ament_cmake untuk CMake) -->
    <architecture_independent/>  <!-- [WAJIB] Package ini tidak tergantung arsitektur (pure Python/URDF/mesh/launch) -->
    <description lang="en">Full robot description, launch, and mesh for Huskybot multi-sensor simulation in ROS2 Humble.</description> <!-- [OPSIONAL] Deskripsi tambahan multi-bahasa -->
    <url type="website">https://github.com/jezzy/huskybot</url> <!-- [OPSIONAL] URL website/repo utama package -->
    <url type="bugtracker">https://github.com/jezzy/huskybot/issues</url> <!-- [OPSIONAL] URL bugtracker/issues -->
    <readme>README.md</readme> <!-- [OPSIONAL] Path ke file README untuk dokumentasi package -->
    <testfile>test/test_pep257.py</testfile> <!-- [OPSIONAL] Contoh file test, agar test otomatis terdeteksi -->
  </export>
</package>